# Required by the server-side /api/research endpoint. Never expose this as a VITE_ variable.
BRAVE_SEARCH_API_KEY=

# Optional random secret used when producing privacy-preserving rate-limit identifiers.
SAFETY_ID_SALT=

# Public URL of the Render backend. This value is bundled into the Vercel frontend.
VITE_API_URL=https://your-whattech-api.onrender.com

# Optional: paste the exact referral URL issued by SmoothCut. UTM tags are added automatically.
VITE_SMOOTHCUT_AFFILIATE_URL=https://smoothcut.studio/
