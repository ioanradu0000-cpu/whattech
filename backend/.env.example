DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whattech
PORT=3001

# Comma-separated exact origins. Add local Vite plus every deployed Vercel/custom domain.
FRONTEND_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# Set true only when the database connection requires TLS.
DATABASE_SSL=false

# Long random value used to hash rate-limit identifiers.
SAFETY_ID_SALT=replace-with-a-long-random-value

